# ---------------------------------------------------------------------------
# Kambio configuration
#
# Every value below has a safe default. With NO changes the app runs fully
# offline: AI returns deterministic rules-based results, documents are stored
# on disk, and jobs run in-process. Add real keys only when you want real
# providers.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kambio
APP_URL=http://localhost:3000
# CHANGE THIS IN PRODUCTION — signs session cookies (min 16 chars).
AUTH_SECRET=kambio-dev-secret-change-me-in-prod

# --- AI gateway ------------------------------------------------------------
# mock | anthropic | openai. "mock" needs no key and no network.
AI_PROVIDER=mock
AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Route individual tasks to different providers, e.g. a cheap model for
# classification and a strong one for extraction.
# AI_PROVIDER_EXTRACT_DOCUMENT=anthropic
# AI_PROVIDER_CLASSIFY_MESSAGE=openai
# AI_PROVIDER_DRAFT_REPLY=anthropic

# Extracted fields below this confidence are routed to human review.
EXTRACTION_REVIEW_THRESHOLD=0.85

# --- OCR -------------------------------------------------------------------
# mock reads text natively (txt/csv/eml) and salvages PDF text layers.
# textract | gcv are stubbed behind the same interface — implement and set a key.
OCR_PROVIDER=mock
# OCR_API_KEY=

# --- Storage ---------------------------------------------------------------
# local writes to STORAGE_LOCAL_DIR; s3 works with AWS, MinIO or R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=kambio-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Queue -----------------------------------------------------------------
# inline runs jobs in the web process (no Redis needed).
# redis uses BullMQ — start `npm run worker` alongside the app.
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# --- Email ingestion -------------------------------------------------------
# Point your provider's inbound-parse webhook at POST /api/inbound/email
INBOUND_EMAIL_DOMAIN=parse.kambio.app
# Shared secret checked as the x-kambio-signature header. Empty = open (dev only).
INBOUND_WEBHOOK_SECRET=
# mock | resend | postmark | sendgrid — mock logs instead of sending.
EMAIL_PROVIDER=mock
# Resend is the default real provider. Verify your sending domain first.
# RESEND_API_KEY=re_...
# EMAIL_API_KEY=      # Postmark server token / SendGrid API key
EMAIL_FROM=ops@kambio.app

# --- Follow-ups ------------------------------------------------------------
# When a party has not answered a review request, Kambio chases them.
# A chaser makes no commitment, is capped, and stops the moment they reply.
# Hours to wait after a review request before the first chaser.
FOLLOWUP_AFTER_HOURS=24
# Hours between subsequent chasers.
FOLLOWUP_INTERVAL_HOURS=24
# Stop after this many; the shipment is then escalated to a human as a blocker.
FOLLOWUP_MAX=3
# true  — chasers go out automatically (the one narrow AI auto-send exception).
# false — each chaser is left as a draft with a task for a human to send.
FOLLOWUP_AUTO_SEND=true

# The sweep runs every 15 minutes in the worker. To drive it from an external
# scheduler instead, POST /api/cron/followups with this bearer token.
# Empty = the endpoint is disabled.
CRON_SECRET=

# --- WhatsApp Business API -------------------------------------------------
# Webhook: GET/POST /api/inbound/whatsapp
WHATSAPP_PROVIDER=mock
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=kambio-verify

# --- Carrier tracking (extension point, not wired into the UI yet) ---------
TRACKING_PROVIDER=mock
# TRACKING_API_KEY=
