# Kambio landing page — Apache config for Hostinger shared hosting.

# --------------------------------------------------------------- HTTPS + host
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Hostinger terminates TLS upstream, so trust the forwarded
  # header as well as the direct one.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical hostname: strip www. Delete this block if you prefer www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------ never served up
# The lead store lives under the web root because shared hosting gives us
# nowhere else to write. Belt and braces: deny the directory, and deny the
# file extension anywhere.
RedirectMatch 404 ^/_leads(/.*)?$

<FilesMatch "\.(jsonl|log|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --------------------------------------------------------------------- headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # The page is fully self-contained: no external scripts, styles or fonts.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# --------------------------------------------------------------------- caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  # HTML stays fresh so edits show up immediately.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ------------------------------------------------------------------ housekeeping
DirectoryIndex index.html index.php
ServerSignature Off
Options -Indexes
